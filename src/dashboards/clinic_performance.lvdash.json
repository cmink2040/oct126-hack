{
  "datasets": [
    {
      "name": "kpi_30d",
      "displayName": "KPIs - last 30 days",
      "queryLines": [
        "SELECT MEASURE(revenue) AS revenue, MEASURE(contribution_margin) AS contribution_margin,\n",
        "       MEASURE(active_patients) AS active_patients, MEASURE(no_show_rate) AS no_show_rate\n",
        "FROM clinic_visit_metrics WHERE visit_date >= date_sub(current_date(), 30)\n"
      ]
    },
    {
      "name": "lead_kpi",
      "displayName": "Lead KPIs - last 180 days",
      "queryLines": [
        "SELECT MEASURE(leads) AS leads, MEASURE(conversion_rate) AS conversion_rate\n",
        "FROM clinic_lead_metrics WHERE created_date >= date_sub(current_date(), 180)\n"
      ]
    },
    {
      "name": "monthly",
      "displayName": "Monthly revenue and margin",
      "queryLines": [
        "SELECT visit_month, MEASURE(revenue) AS revenue, MEASURE(contribution_margin) AS contribution_margin,\n",
        "       MEASURE(active_patients) AS active_patients\n",
        "FROM clinic_visit_metrics WHERE visit_date >= add_months(current_date(), -24) GROUP BY ALL\n"
      ]
    },
    {
      "name": "service_mix",
      "displayName": "Revenue by service",
      "queryLines": [
        "SELECT visit_month, service_name, MEASURE(revenue) AS revenue\n",
        "FROM clinic_visit_metrics WHERE visit_date >= add_months(current_date(), -12) GROUP BY ALL\n"
      ]
    },
    {
      "name": "lead_source",
      "displayName": "Lead conversion by source",
      "queryLines": [
        "SELECT source, MEASURE(leads) AS leads, MEASURE(conversion_rate) AS conversion_rate\n",
        "FROM clinic_lead_metrics WHERE created_date >= date_sub(current_date(), 365) GROUP BY ALL\n"
      ]
    },
    {
      "name": "lead_intent",
      "displayName": "AI-classified lead intent",
      "queryLines": [
        "SELECT ai_intent, MEASURE(leads) AS leads\n",
        "FROM clinic_lead_metrics WHERE created_date >= date_sub(current_date(), 90) GROUP BY ALL\n"
      ]
    },
    {
      "name": "response",
      "displayName": "Conversion by response time",
      "queryLines": [
        "SELECT response_band, MEASURE(conversion_rate) AS conversion_rate, MEASURE(closed_leads) AS closed_leads\n",
        "FROM clinic_lead_metrics WHERE response_band <> 'not yet' GROUP BY ALL\n"
      ]
    },
    {
      "name": "cohort",
      "displayName": "Cohort retention curve",
      "queryLines": [
        "SELECT months_since_first_visit, ROUND(AVG(retention_rate), 3) AS avg_retention\n",
        "FROM gold_cohort_retention WHERE months_since_first_visit BETWEEN 0 AND 12 GROUP BY ALL\n"
      ]
    },
    {
      "name": "payer",
      "displayName": "Revenue by payer",
      "queryLines": [
        "SELECT visit_month, payer, MEASURE(revenue) AS revenue\n",
        "FROM clinic_visit_metrics WHERE visit_date >= add_months(current_date(), -12) GROUP BY ALL\n"
      ]
    },
    {
      "name": "queues",
      "displayName": "Agent review queues",
      "queryLines": [
        "SELECT 'lead' AS queue, status, COUNT(*) AS items FROM lead_actions GROUP BY ALL\n",
        "UNION ALL SELECT 'retention', status, COUNT(*) FROM retention_actions GROUP BY ALL\n",
        "UNION ALL SELECT 'price', status, COUNT(*) FROM price_recommendations GROUP BY ALL\n"
      ]
    },
    {
      "name": "risk",
      "displayName": "Churn risk distribution",
      "queryLines": [
        "SELECT CASE WHEN churn_risk >= 0.75 THEN '4 critical' WHEN churn_risk >= 0.5 THEN '3 high'\n",
        "            WHEN churn_risk >= 0.25 THEN '2 medium' ELSE '1 low' END AS risk_band,\n",
        "       COUNT(*) AS patients, ROUND(SUM(churn_risk * ltv_annual), 0) AS expected_annual_loss\n",
        "FROM patient_churn_risk GROUP BY ALL\n"
      ]
    }
  ],
